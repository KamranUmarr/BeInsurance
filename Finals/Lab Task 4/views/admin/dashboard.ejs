<%- include('../partials/admin-header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Product Management</h2>
    <a href="/admin/products/add" class="btn btn-success"><i class="fa fa-plus"></i> Add New Product</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover table-striped mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Image</th>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% products.forEach(product => { %>
                <tr class="align-middle">
                    <td>
                        <img src="<%= product.image %>" alt="" style="width: 50px; height: 50px; object-fit: contain;">
                    </td>
                    <td><%= product.title %></td>
                    <td><span class="badge bg-info text-dark"><%= product.category %></span></td>
                    <td>$<%= product.price %></td>
                    <td class="text-end">
                        <div class="d-flex justify-content-end gap-2">
                            <!-- Edit Button -->
                            <a href="/admin/products/edit/<%= product._id %>" class="btn btn-sm btn-warning">
                                <i class="fa fa-edit"></i>
                            </a>

                            <!-- Delete Button Form -->
                            <!-- Note the ?_method=DELETE query parameter -->
                            <form action="/admin/products/<%= product._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure?');">
                                <button type="submit" class="btn btn-sm btn-danger"><i class="fa fa-trash"></i></button>
                            </form>
                        </div>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../partials/admin-footer') %>