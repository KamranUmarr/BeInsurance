<%- include('../partials/admin-header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Order Management</h2>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover table-striped mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Total</th>
                    <th>Current Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <% orders.forEach(order => { %>
                <tr class="align-middle">
                    <td><small>#<%= order._id.toString().slice(-6) %></small></td>
                    <td>
                        <%= order.customer.fullname %><br>
                        <small class="text-muted"><%= order.customer.email %></small>
                    </td>
                    <td><%= order.date.toDateString() %></td>
                    <td>$<%= order.totalAmount.toFixed(2) %></td>
                    
                    <!-- Status Badge -->
                    <td>
                        <% if (order.status === 'Placed') { %>
                            <span class="badge bg-secondary">Placed</span>
                        <% } else if (order.status === 'Processing') { %>
                            <span class="badge bg-warning text-dark">Processing</span>
                        <% } else { %>
                            <span class="badge bg-success">Delivered</span>
                        <% } %>
                    </td>

                    <!-- Action Buttons (State Machine UI) -->
                    <td>
                        <form action="/admin/order/status" method="POST">
                            <input type="hidden" name="orderId" value="<%= order._id %>">
                            
                            <% if (order.status === 'Placed') { %>
                                <!-- Option 1: Move to Processing -->
                                <button type="submit" name="newStatus" value="Processing" class="btn btn-sm btn-primary">
                                    Mark Processing <i class="fa fa-arrow-right"></i>
                                </button>
                            
                            <% } else if (order.status === 'Processing') { %>
                                <!-- Option 2: Move to Delivered -->
                                <button type="submit" name="newStatus" value="Delivered" class="btn btn-sm btn-success">
                                    Mark Delivered <i class="fa fa-check"></i>
                                </button>
                            
                            <% } else { %>
                                <!-- Option 3: Completed -->
                                <span class="text-success"><i class="fa fa-check-double"></i> Completed</span>
                            <% } %>
                        </form>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../partials/admin-footer') %>