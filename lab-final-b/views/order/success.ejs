<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head', { title: 'Order Success' }) %>
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="container text-center mt-5 mb-5" style="min-height: 50vh; display: flex; flex-direction: column; justify-content: center;">
        <div class="display-1 text-success mb-3">
            <i class="fa fa-check-circle"></i>
        </div>
        <h1>Thank You!</h1>
        <p class="lead">Your order has been placed successfully.</p>
        <p>We will contact you shortly at your email address.</p>
        
        <div class="mt-4">
            <a href="/products" class="btn btn-primary">Continue Shopping</a>
        </div>
    </div>

    <%- include('../partials/footer') %>
    
    <!-- Optional: Script to clear LocalStorage cart if you were using one -->
    <script>
        localStorage.removeItem('cart'); // Assuming you stored cart in LS
    </script>
</body>
</html>