<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        body { min-height: 100vh; display: flex; flex-direction: column; }
        .wrapper { display: flex; width: 100%; flex: 1; }
        #sidebar { min-width: 250px; max-width: 250px; background: #002060; color: #fff; min-height: 100vh; }
        #sidebar .nav-link { color: #b3d1e9; padding: 15px 20px; font-size: 1.1rem; }
        #sidebar .nav-link:hover, #sidebar .nav-link.active { color: #fff; background: #036cb2; }
        #content { width: 100%; padding: 40px; background: #f8f9fa; }
    </style>
</head>
<body>
    <div class="wrapper">
        <!-- Sidebar Navigation -->
        <nav id="sidebar">
            <div class="sidebar-header p-4">
                <h3><i class="fa fa-cogs"></i> Admin</h3>
            </div>
            <ul class="list-unstyled components">
                <li><a href="/products" class="nav-link"><i class="fa fa-arrow-left me-2"></i> Back to Shop</a></li>
                <li><a href="/admin/products" class="nav-link active"><i class="fa fa-box-open me-2"></i> Products</a></li>
                <li>
                    <a href="/admin/orders" class="nav-link">
                        <i class="fa fa-shopping-cart me-2"></i> Manage Orders
                    </a>
                </li>
            </ul>
        </nav>
        
        <!-- Main Content Area Starts Here -->
        <div id="content">