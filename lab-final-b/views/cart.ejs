<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { title: 'Checkout' }) %>
    <link rel="stylesheet" href="/css/checkout.css">
</head>
<body>
    
    <%- include('partials/navbar') %>

    <header class="checkout-header">
        <h1 class="mb-2" style="font-family: Arial, Helvetica, sans-serif; font-weight: bold; letter-spacing: 1px;">
            Checkout
        </h1>
        <nav aria-label="Checkout steps" class="checkout-steps">
            <span class="checkout-step">Cart</span>
            <span class="checkout-step">Address</span>
            <span class="checkout-step">Payment</span>
            <span class="checkout-step active">Review</span>
        </nav>
    </header>

    <main class="checkout-main">
        <div class="container">
            <div class="row g-4">
                <div class="col-12 col-md-7">
                    <!-- CHANGED: Added action and method -->
                    <form action="/order/preview" method="POST" id="checkoutForm">
                        
                        <!-- NEW: Container for Hidden Inputs (Populated by JS) -->
                        <div id="hidden-cart-inputs"></div>

                        <!-- Customer Info -->
                        <div class="card mb-4">
                            <div class="card-body">
                                <h4 class="mb-3" style="color:#002060;">Customer & Shipping</h4>
                                <div class="row g-3">
                                    <div class="col-12 col-md-6">
                                        <div class="form-floating">
                                            <!-- CHANGED: Added name="fullname" -->
                                            <input type="text" class="form-control" id="fullname" name="fullname" placeholder="Full Name" required>
                                            <label for="fullname">Full Name</label>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <div class="form-floating">
                                            <!-- CHANGED: Added name="email" -->
                                            <input type="email" class="form-control" id="email" name="email" placeholder="Email" required>
                                            <label for="email">Email</label>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <div class="form-floating">
                                            <!-- CHANGED: Added name="phone" -->
                                            <input type="tel" class="form-control" id="phone" name="phone" placeholder="Phone" required>
                                            <label for="phone">Phone</label>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-floating">
                                            <!-- CHANGED: Added name="address" -->
                                            <input type="text" class="form-control" id="address" name="address" placeholder="Address" required>
                                            <label for="address">Address</label>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <div class="form-floating">
                                            <!-- CHANGED: Added name="city" -->
                                            <input type="text" class="form-control" id="city" name="city" placeholder="City" required>
                                            <label for="city">City</label>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="form-floating">
                                            <!-- CHANGED: Added name="postal" -->
                                            <input type="text" class="form-control" id="postal" name="postal" placeholder="Postal Code" required>
                                            <label for="postal">Postal Code</label>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="form-floating">
                                            <!-- CHANGED: Added name="country" -->
                                            <select class="form-select" id="country" name="country" required>
                                                <option value="">Choose...</option>
                                                <option>Pakistan</option>
                                                <option>USA</option>
                                                <option>UK</option>
                                            </select>
                                            <label for="country">Country</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="card mb-4">
                            <div class="card-body">
                                <button class="btn btn-primary w-100" type="submit" id="placeOrderBtn">Proceed to Preview</button>
                            </div>
                        </div>
                    </form>
                </div>
                
                <!-- RIGHT SIDE: Dynamic Cart Summary -->
                <div class="col-12 col-md-5">
                    <div class="order-summary position-sticky">
                        <h4 class="mb-3" style="color:#002060;">Order Summary</h4>
                        
                        <!-- Dynamic List (Populated by JS) -->
                        <ul class="list-group mb-3" id="cart-visual-list">
                            <li class="list-group-item text-center">Your cart is empty.</li>
                        </ul>

                        <div class="mb-3">
                            <label class="form-label text-muted">Coupon Code</label>
                            <div class="input-group">
                                <!-- NAME="coupon" is vital so middleware can read req.body.coupon -->
                                <input type="text" class="form-control" name="coupon" placeholder="Enter code (e.g. SAVE10)" form="checkoutForm">
                            </div>
                            <small class="text-muted">Try 'SAVE10' for 10% off</small>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span class="summary-label">Subtotal</span>
                            <span class="summary-value" id="cart-total">₨0.00</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="grand-total">Grand Total</span>
                            <span class="grand-total" id="cart-grand-total">₨0.00</span>
                        </div>                   
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>

    <!-- SCRIPT TO LOAD CART FROM LOCALSTORAGE -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const cart = JSON.parse(localStorage.getItem('cart')) || [];
            const visualList = document.getElementById('cart-visual-list');
            const hiddenInputs = document.getElementById('hidden-cart-inputs');
            const totalEl = document.getElementById('cart-total');
            const grandTotalEl = document.getElementById('cart-grand-total');

            if (cart.length > 0) {
                visualList.innerHTML = '';
                hiddenInputs.innerHTML = '';
                let total = 0;

                cart.forEach((item, index) => {
                    let itemTotal = item.price * item.quantity;
                    total += itemTotal;

                    // 1. Add Visual Item to Sidebar
                    visualList.innerHTML += `
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>${item.title} <small class="text-muted">x${item.quantity}</small></span>
                            <span class="text-nowrap">$${itemTotal.toFixed(2)}</span>
                        </li>
                    `;

                    // 2. Add Hidden Inputs for Form Submission
                    // These are sent to the backend when you click "Proceed"
                    hiddenInputs.innerHTML += `
                        <input type="hidden" name="titles" value="${item.title}">
                        <input type="hidden" name="prices" value="${item.price}">
                        <input type="hidden" name="quantities" value="${item.quantity}">
                    `;
                });
                

                totalEl.textContent = '$' + total.toFixed(2);
                grandTotalEl.textContent = '$' + total.toFixed(2);
            }
        });
    </script>
</body>
</html>